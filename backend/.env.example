# QueueStorm Investigator environment configuration
# Copy this file to .env and fill in real values.

# Primary LLM (paid tier, recommended).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model override. Default is gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Secondary LLM (free tier, used as fallback if Gemini is unavailable).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Groq model override. Default is llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: per-request timeout in seconds for the LLM call.
REQUEST_TIMEOUT_SECONDS=25

# Optional: comma-separated CORS origins. Use * to allow all (default).
CORS_ORIGINS=*
